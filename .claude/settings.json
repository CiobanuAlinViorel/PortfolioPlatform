{
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "PowerShell(Get-Command pnpm -ErrorAction SilentlyContinue)",
      "PowerShell(pnpm -v 2>&1)",
      "PowerShell(node -v)",
      "PowerShell(npm -v)",
      "PowerShell(corepack -v 2>&1)",
      "PowerShell(corepack enable 2>&1)",
      "PowerShell(corepack prepare pnpm@11.9.0 --activate 2>&1)",
      "PowerShell(npm install -g pnpm@11.9.0 2>&1)",
      "PowerShell(pnpm approve-builds 2>&1)",
      "PowerShell(pnpm install 2>&1)",
      "PowerShell(pnpm ng version 2>&1)",
      "PowerShell(winget upgrade OpenJS.NodeJS --accept-source-agreements --accept-package-agreements 2>&1)",
      "PowerShell(winget list --name Node 2>&1)",
      "PowerShell(winget upgrade OpenJS.NodeJS.22 --accept-source-agreements --accept-package-agreements 2>&1)",
      "PowerShell($env:Path = [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\); node -v; npm -v; pnpm -v)",
      "PowerShell(pnpm start 2>&1)",
      "Bash(git check-ignore *)",
      "Bash(mvn -q -o compile test-compile)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(curl -s http://localhost:4200/)"
    ]
  }
}
